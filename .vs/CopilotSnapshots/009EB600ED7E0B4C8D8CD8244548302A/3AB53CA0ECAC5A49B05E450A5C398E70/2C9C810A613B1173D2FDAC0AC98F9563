using pz6.forms;
using System;
using System.Data.SQLite;
using System.Windows.Forms;

namespace pz6
{
    public partial class FMDI : Form
    {
        private SQLiteConnection sqliteConn;
        private string ConnectionString = "Data Source=sklad_t_o.db;Version=3;";

        public FMDI()
        {
            InitializeComponent();
            sqliteConn = new SQLiteConnection(ConnectionString);
            sqliteConn.Open();
        }

        private void createTable(string text)
        {
            bool flag = true;
            foreach (var a in MdiChildren)
            {
                if (a.Text == text)
                {
                    flag = false;
                    break;
                }
            }
            if (flag)
            {
                // Для Клиентов и Поставок используем форму Table2 (мастер-деталь)
                if (text == "Клиенты" || text == "Поставки")
                {
                    Table2 t2 = new Table2(text, ConnectionString)
                    {
                        MdiParent = this
                    };
                    t2.Show();
                }
                else
                {
                    Table t = new Table(text, ConnectionString)
                    {
                        MdiParent = this
                    };
                    t.Show();
                }
            }
        }

