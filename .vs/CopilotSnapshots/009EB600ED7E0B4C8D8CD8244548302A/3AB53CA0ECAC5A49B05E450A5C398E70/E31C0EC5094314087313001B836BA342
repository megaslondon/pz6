        private void DelTableTop_Click(object sender, EventArgs e)
        {
            if (dataGridView1.CurrentRow == null) return;
            var idObj = dataGridView1.CurrentRow.Cells[0].Value;
            if (idObj == null) return;
            if (!int.TryParse(idObj.ToString(), out int id)) return;

            var res = MessageBox.Show("Вы действительно хотите удалить выбранную запись?", "Подтвердите удаление", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (res != DialogResult.Yes) return;

            string sql = null;
            if (this.Name == "Клиенты") sql = "DELETE FROM client WHERE client_id = @id;";
            else if (this.Name == "Поставки") sql = "DELETE FROM delivery WHERE delivery_id = @id;";
            else
            {
                MessageBox.Show("Удаление для этой таблицы не реализовано.", "Информация", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            using (var cmd = new SQLiteCommand(sql, sc))
            {
                cmd.Parameters.AddWithValue("@id", id);
                try
                {
                    sc.Open();
                    cmd.ExecuteNonQuery();
                    sc.Close();
                }
                catch (Exception ex)
                {
                    if (sc.State == ConnectionState.Open) sc.Close();
                    MessageBox.Show("Ошибка при удалении: " + ex.Message, "Ошибка", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }
            }

            // обновить верхнюю таблицу
            topDt.Clear();
            topAdapter.Fill(topDt);
        }

        private void CloseTableTop_Click(object sender, EventArgs e)
        {
            this.Close();
        }

        private void InsTableBottom_Click(object sender, EventArgs e)
        {
            try
            {
                if (this.Name == "Клиенты")
                {
                    using (var f = new InsEditGeneric("Добавление заказа", "orders", sc.ConnectionString, null))
                    {
                        if (f.ShowDialog() == DialogResult.OK)
                        {
                            // refresh bottom for current client
                            if (dataGridView1.CurrentRow != null)
                            {
                                int cid = Convert.ToInt32(dataGridView1.CurrentRow.Cells[0].Value);
                                LoadOrdersForClient(cid);
                            }
                        }
                    }
                }
                else if (this.Name == "Поставки")
                {
                    // попробуем определить таблицу состава
                    string tbl = null;
                    using (var cmd = new SQLiteCommand("SELECT name FROM sqlite_master WHERE type='table' AND (name='delivery_product' OR name='delivery_item') LIMIT 1;", sc))
                    {
                        sc.Open(); var o = cmd.ExecuteScalar(); sc.Close(); if (o != null) tbl = o.ToString();
                    }
                    if (!string.IsNullOrEmpty(tbl))
                    {
                        using (var f = new InsEditGeneric("Добавление позиции поставки", tbl, sc.ConnectionString, null))
                        {
                            if (f.ShowDialog() == DialogResult.OK && dataGridView1.CurrentRow != null)
                            {
                                LoadDeliveryComposition(Convert.ToInt32(dataGridView1.CurrentRow.Cells[0].Value));
                            }
                        }
                    }
                    else
                    {
                        MessageBox.Show("Таблица состава поставки не найдена.", "Информация", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Ошибка: " + ex.Message, "Ошибка", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

