    public partial class Table2 : Form
    {
        private SQLiteConnection sc = new SQLiteConnection();
        private SQLiteDataAdapter topAdapter;
        private SQLiteDataAdapter bottomAdapter;
        private DataTable topDt = new DataTable();
        private DataTable bottomDt = new DataTable();

        private string topQuery;
        private string bottomQueryTemplate;

        public Table2(string nameF, string connString)
        {
            InitializeComponent();
            this.Text = nameF;
            this.Name = nameF;
            this.sc.ConnectionString = connString;

            switch (this.Name)
            {
                case "Клиенты":
                    topQuery = "SELECT client_id AS 'ИД', name AS 'Имя', phone AS 'Телефон', email AS 'Электронная почта' FROM client;";
                    bottomQueryTemplate = "SELECT o.order_id AS 'ИД заказа', o.order_date AS 'Дата', s.name AS 'Статус', o.city AS 'Город', o.street AS 'Улица', o.house_number AS 'Дом', o.building AS 'Корпус', o.apartment AS 'Квартира' FROM orders o JOIN status s ON o.status_id = s.status_id WHERE o.client_id = @id AND s.name <> 'Выполнен';";
                    break;

                case "Поставки":
                    topQuery = "SELECT d.delivery_id AS 'ИД поставки', d.delivery_date AS 'Дата', e.last_name || ' ' || e.first_name AS 'Сотрудник', w.name AS 'Склад', s.name AS 'Поставщик' FROM delivery d JOIN employee e ON d.employee_id = e.employee_id JOIN warehouse w ON d.warehouse_id = w.warehouse_id LEFT JOIN supplier s ON d.supplier_id = s.supplier_id;";
                    // bottomQueryTemplate will be chosen dynamically depending on existence of delivery composition table
                    bottomQueryTemplate = null;
                    break;

                default:
                    MessageBox.Show("Ошибка! Выбранная таблица не может быть отражена!");
                    break;
            }

            // load top
            if (!string.IsNullOrEmpty(topQuery))
            {
                topAdapter = new SQLiteDataAdapter(topQuery, sc);
                topDt.Clear();
                topAdapter.Fill(topDt);
                dataGridView1.DataSource = topDt;
            }

            // initial bottom empty
            dataGridView2.DataSource = bottomDt;

            // subscribe events
            dataGridView1.SelectionChanged += DataGridView1_SelectionChanged;

            InsTableTop.Click += InsTableTop_Click;
            EditTableTop.Click += EditTableTop_Click;
            DelTableTop.Click += DelTableTop_Click;
            CloseTableTop.Click += CloseTableTop_Click;

            InsTableBottom.Click += InsTableBottom_Click;
            EditTableBottom.Click += EditTableBottom_Click;
            DelTableBottom.Click += DelTableBottom_Click;
            CloseTableBottom.Click += CloseTableBottom_Click;
        }

        private void DataGridView1_SelectionChanged(object sender, EventArgs e)
        {
            if (dataGridView1.CurrentRow == null) return;

            object idObj = dataGridView1.CurrentRow.Cells[0].Value;
            if (idObj == null) return;

            int id;
            if (!int.TryParse(idObj.ToString(), out id)) return;

            switch (this.Name)
            {
                case "Клиенты":
                    LoadOrdersForClient(id);
                    break;

                case "Поставки":
                    LoadDeliveryComposition(id);
                    break;
            }
        }

        private void LoadOrdersForClient(int clientId)
        {
            bottomDt.Clear();
            bottomAdapter = new SQLiteDataAdapter();
            var cmd = new SQLiteCommand(bottomQueryTemplate, sc);
            cmd.Parameters.AddWithValue("@id", clientId);
            bottomAdapter.SelectCommand = cmd;
            bottomAdapter.Fill(bottomDt);
            dataGridView2.DataSource = bottomDt;
        }

        private void LoadDeliveryComposition(int deliveryId)
        {
            bottomDt.Clear();

            // проверим наличие таблицы delivery_product или delivery_item
            string checkSql = "SELECT name FROM sqlite_master WHERE type='table' AND (name='delivery_product' OR name='delivery_item') LIMIT 1;";
            using (var cmdCheck = new SQLiteCommand(checkSql, sc))
            {
                try
                {
                    sc.Open();
                    var obj = cmdCheck.ExecuteScalar();
                    sc.Close();
                    if (obj != null && obj.ToString() == "delivery_product")
                    {
                        string q = "SELECT dp.delivery_id AS 'ИД поставки', p.name AS 'Товар', dp.quantity AS 'Количество', dp.price AS 'Цена' FROM delivery_product dp JOIN product p ON dp.product_id = p.product_id WHERE dp.delivery_id = @id;";
                        bottomAdapter = new SQLiteDataAdapter(q, sc);
                        bottomAdapter.SelectCommand.Parameters.AddWithValue("@id", deliveryId);
                        bottomAdapter.Fill(bottomDt);
                        dataGridView2.DataSource = bottomDt;
                        return;
                    }
                    else if (obj != null && obj.ToString() == "delivery_item")
                    {
                        string q = "SELECT di.delivery_id AS 'ИД поставки', di.product_name AS 'Товар', di.quantity AS 'Количество' FROM delivery_item di WHERE di.delivery_id = @id;";
                        bottomAdapter = new SQLiteDataAdapter(q, sc);
                        bottomAdapter.SelectCommand.Parameters.AddWithValue("@id", deliveryId);
                        bottomAdapter.Fill(bottomDt);
                        dataGridView2.DataSource = bottomDt;
                        return;
                    }
                }
                catch
                {
                    if (sc.State == ConnectionState.Open) sc.Close();
                }
            }

            // Если состав поставки не найден, показать общую информацию о поставке
            string fallback = "SELECT d.delivery_id AS 'ИД поставки', d.delivery_date AS 'Дата', e.last_name || ' ' || e.first_name AS 'Сотрудник', w.name AS 'Склад', s.name AS 'Поставщик' FROM delivery d JOIN employee e ON d.employee_id = e.employee_id JOIN warehouse w ON d.warehouse_id = w.warehouse_id LEFT JOIN supplier s ON d.supplier_id = s.supplier_id WHERE d.delivery_id = @id;";
            bottomAdapter = new SQLiteDataAdapter();
            var cmd = new SQLiteCommand(fallback, sc);
            cmd.Parameters.AddWithValue("@id", deliveryId);
            bottomAdapter.SelectCommand = cmd;
            bottomAdapter.Fill(bottomDt);
            dataGridView2.DataSource = bottomDt;
        }

