                Path.Combine(baseDir, "..", "..", "icons"),
                Path.Combine(baseDir, "pz6", "icons"),
                Path.Combine(baseDir, "..", "pz6", "icons"),
                Path.Combine(baseDir, "..", "..", "pz6", "icons")
            };
            foreach (var c in candidates)
            {
                try
                {
                    var full = Path.GetFullPath(c);
                    if (Directory.Exists(full)) return full;
                }
                catch { }
            }
            return null;
        }

